    {
      "description": "Inicia cronômetros identificados por uma etiqueta; a condição \"Ao cronômetro\" dispara quando a duração termina (uma vez ou regularmente).",
      "fullName": "Cronômetro",
      "helpPath": "",
      "iconUrl": "",
      "name": "Timer",
      "objectType": "",
      "previewIconUrl": "",
      "eventsFunctions": [
        {
          "description": "Inicia (ou reinicia) um cronômetro com a etiqueta e a duração dadas.",
          "fullName": "Iniciar cronômetro",
          "functionType": "Action",
          "name": "StartTimer",
          "sentence": "Iniciar o cronômetro _PARAM4_ de _PARAM0_ por _PARAM2_ segundos (_PARAM3_)",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "Object",
                    "__A3Timer[Tag]",
                    "=",
                    "Duration"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "Object",
                    "__A3TimerRegular[Tag]",
                    "=",
                    "0"
                  ]
                },
                {
                  "type": {
                    "value": "ResetObjectTimer"
                  },
                  "parameters": [
                    "Object",
                    "Tag"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "StringVariable"
                  },
                  "parameters": [
                    "Type",
                    "=",
                    "\"Regular\""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberObjectVariable"
                  },
                  "parameters": [
                    "Object",
                    "__A3TimerRegular[Tag]",
                    "=",
                    "1"
                  ]
                }
              ]
            }
          ],
          "parameters": [
            {
              "description": "Objeto",
              "name": "Object",
              "type": "object"
            },
            {
              "description": "Comportamento",
              "name": "Behavior",
              "supplementaryInformation": "A3Timer::Timer",
              "type": "behavior"
            },
            {
              "description": "Duração (segundos)",
              "name": "Duration",
              "type": "expression"
            },
            {
              "description": "Tipo",
              "name": "Type",
              "supplementaryInformation": "[\"Uma vez\",\"Regular\"]",
              "type": "stringWithSelector"
            },
            {
              "description": "Etiqueta",
              "name": "Tag",
              "type": "string"
            }
          ],
          "objectGroups": []
