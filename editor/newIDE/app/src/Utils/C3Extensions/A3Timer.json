        {
          "description": "Verdadeiro quando o cronômetro termina (reinicia se for regular, para se for único).",
          "fullName": "Ao cronômetro",
          "functionType": "Condition",
          "name": "OnTimer",
          "sentence": "Ao terminar o cronômetro _PARAM2_ de _PARAM0_",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "CompareObjectTimer"
                  },
                  "parameters": [
                    "Object",
                    "Tag",
                    ">=",
                    "Object.Variable(__A3Timer[Tag])"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetReturnBoolean"
                  },
                  "parameters": [
                    "True"
                  ]
                }
              ],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberObjectVariable"
                      },
                      "parameters": [
                        "Object",
                        "__A3TimerRegular[Tag]",
