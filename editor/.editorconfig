# c3: the fork keeps GDevelop's style; stops the Laravel root .editorconfig
# (indent_size = 4) from reaching prettier here.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
