                  "actions": [
                    {
                      "type": {
                        "value": "A3TileMovement::TileMovement::MoveInDirection"
                      },
                      "parameters": [
                        "Object",
                        "Behavior",
                        "\"Cima\""
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "KeyFromTextPressed"
                      },
                      "parameters": [
                        "",
                        "\"Down\""
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "A3TileMovement::TileMovement::MoveInDirection"
                      },
                      "parameters": [
                        "Object",
                        "Behavior",
                        "\"Baixo\""
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BooleanVariable"
                  },
                  "parameters": [
                    "Moving",
                    "True",
                    ""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetX"
                  },
                  "parameters": [
                    "Object",
                    "+",
                    "clamp(TargetX - Object.X(), -Speed * GridWidth * TimeDelta(), Speed * GridWidth * TimeDelta())"
                  ]
                },
                {
                  "type": {
                    "value": "SetY"
                  },
                  "parameters": [
                    "Object",
                    "+",
                    "clamp(TargetY - Object.Y(), -Speed * GridHeight * TimeDelta(), Speed * GridHeight * TimeDelta())"
                  ]
                }
              ],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::CompareNumbers"
                      },
                      "parameters": [
                        "abs(TargetX - Object.X())",
                        "<",
                        "0.01"
                      ]
                    },
                    {
                      "type": {
                        "value": "BuiltinCommonInstructions::CompareNumbers"
                      },
                      "parameters": [
                        "abs(TargetY - Object.Y())",
                        "<",
                        "0.01"
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetXY"
                      },
                      "parameters": [
                        "Object",
                        "=",
                        "TargetX",
                        "=",
                        "TargetY"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetBooleanVariable"
                      },
                      "parameters": [
                        "Moving",
                        "False",
                        ""
                      ]
                    }
                  ]
                }
              ]
            }
          ],
