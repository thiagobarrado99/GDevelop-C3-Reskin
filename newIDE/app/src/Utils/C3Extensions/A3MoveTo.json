      "iconUrl": "",
      "name": "MoveTo",
      "objectType": "",
      "previewIconUrl": "",
      "eventsFunctions": [
        {
          "fullName": "",
          "functionType": "Action",
          "name": "doStepPreEvents",
          "sentence": "",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetBooleanVariable"
                  },
                  "parameters": [
                    "Arrived",
                    "False",
                    ""
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BooleanVariable"
                  },
                  "parameters": [
                    "Moving",
                    "True",
                    ""
                  ]
                },
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Object.DistanceToPosition(TargetX, TargetY)",
                    "<=",
                    "MaxSpeed * TimeDelta()"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetXY"
                  },
                  "parameters": [
                    "Object",
                    "=",
                    "TargetX",
                    "=",
                    "TargetY"
                  ]
                },
                {
                  "type": {
                    "value": "SetBooleanVariable"
                  },
                  "parameters": [
                    "Moving",
                    "False",
                    ""
                  ]
                },
                {
                  "type": {
                    "value": "SetBooleanVariable"
                  },
                  "parameters": [
                    "Arrived",
                    "True",
                    ""
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BooleanVariable"
                  },
                  "parameters": [
                    "Moving",
                    "True",
                    ""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetXY"
                  },
                  "parameters": [
                    "Object",
                    "+",
                    "cos(Object.AngleToPosition(TargetX, TargetY) * Pi() / 180) * MaxSpeed * TimeDelta()",
                    "+",
                    "sin(Object.AngleToPosition(TargetX, TargetY) * Pi() / 180) * MaxSpeed * TimeDelta()"
                  ]
                }
              ]
            }
          ],
          "parameters": [
            {
              "description": "Objeto",
