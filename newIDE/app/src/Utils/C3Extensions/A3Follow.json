    {
      "description": "Faz o objeto seguir outro objeto. Use a ação \"Seguir objeto\" em um evento sem condições (a cada quadro).",
      "fullName": "Seguir",
      "helpPath": "",
      "iconUrl": "",
      "name": "Follow",
      "objectType": "",
      "previewIconUrl": "",
      "eventsFunctions": [
        {
          "description": "Aproxima o objeto do objeto seguido (use a cada quadro).",
          "fullName": "Seguir objeto",
          "functionType": "Action",
          "name": "FollowObject",
          "sentence": "_PARAM0_ segue _PARAM2_",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Object.Distance(Target)",
                    ">",
                    "Distance"
                  ]
                }
              ],
              "actions": [],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "Speed",
                        "<=",
                        "0"
                      ]
                    }
                  ],
                  "actions": [],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BooleanVariable"
                          },
                          "parameters": [
                            "FollowX",
                            "True",
                            ""
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetX"
                          },
                          "parameters": [
                            "Object",
                            "=",
                            "Target.CenterX() - (Object.CenterX() - Object.X()) - cos(Object.AngleToObject(Target) * Pi() / 180) * Distance"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BooleanVariable"
                          },
                          "parameters": [
                            "FollowY",
                            "True",
                            ""
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetY"
                          },
                          "parameters": [
                            "Object",
                            "=",
                            "Target.CenterY() - (Object.CenterY() - Object.Y()) - sin(Object.AngleToObject(Target) * Pi() / 180) * Distance"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "NumberVariable"
                      },
                      "parameters": [
                        "Speed",
                        ">",
                        "0"
                      ]
                    }
                  ],
                  "actions": [],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BooleanVariable"
                          },
                          "parameters": [
                            "FollowX",
                            "True",
                            ""
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetX"
                          },
                          "parameters": [
                            "Object",
                            "+",
                            "cos(Object.AngleToObject(Target) * Pi() / 180) * min(Speed * TimeDelta(), Object.Distance(Target) - Distance)"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BooleanVariable"
                          },
                          "parameters": [
                            "FollowY",
                            "True",
                            ""
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetY"
                          },
                          "parameters": [
                            "Object",
                            "+",
                            "sin(Object.AngleToObject(Target) * Pi() / 180) * min(Speed * TimeDelta(), Object.Distance(Target) - Distance)"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "parameters": [
            {
              "description": "Objeto",
              "name": "Object",
              "type": "object"
            },
            {
              "description": "Comportamento",
              "name": "Behavior",
              "supplementaryInformation": "A3Follow::Follow",
              "type": "behavior"
            },
            {
              "description": "Objeto a seguir",
              "name": "Target",
              "type": "objectList"
            }
          ],
          "objectGroups": []
        }
      ],
