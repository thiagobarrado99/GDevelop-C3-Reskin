    {
      "description": "Condições para saber se o objeto enxerga outro objeto: dentro do alcance, dentro do cone de visão e sem obstáculos entre os dois.",
      "fullName": "Campo de visão",
      "helpPath": "",
      "iconUrl": "",
      "name": "LineOfSight",
      "objectType": "",
      "previewIconUrl": "",
      "eventsFunctions": [
        {
          "description": "Verdadeiro se o objeto alvo está no alcance, dentro do cone de visão e sem obstáculos entre os dois (o caminho é testado a cada 8 pixels).",
          "fullName": "Tem campo de visão para",
          "functionType": "Condition",
          "name": "HasLineOfSightTo",
          "sentence": "_PARAM0_ tem campo de visão para _PARAM2_ (obstáculos: _PARAM3_)",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Object.Distance(Target)",
                    "<=",
                    "Range"
                  ]
                },
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "abs(AngleDifference(Object.Angle(), Object.AngleToObject(Target)))",
                    "<=",
                    "ConeOfView / 2"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetBooleanVariable"
                  },
                  "parameters": [
                    "Blocked",
                    "False",
                    ""
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "Steps",
                    "=",
                    "max(1, ceil(Object.Distance(Target) / 8))"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "Step",
                    "=",
                    "1"
                  ]
                }
              ],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Repeat",
                  "repeatExpression": "Steps - 1",
                  "conditions": [],
                  "actions": [],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "CollisionPoint"
                          },
                          "parameters": [
                            "Obstacles",
                            "Object.CenterX() + (Target.CenterX() - Object.CenterX()) * Step / Steps",
                            "Object.CenterY() + (Target.CenterY() - Object.CenterY()) * Step / Steps"
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetBooleanVariable"
                          },
                          "parameters": [
                            "Blocked",
                            "True",
                            ""
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [],
                      "actions": [
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "Step",
                            "+",
                            "1"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "BuiltinCommonInstructions::Standard",
                  "conditions": [
                    {
                      "type": {
                        "value": "BooleanVariable"
                      },
                      "parameters": [
                        "Blocked",
                        "False",
                        ""
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": {
                        "value": "SetReturnBoolean"
                      },
                      "parameters": [
                        "True"
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "parameters": [
            {
              "description": "Objeto",
              "name": "Object",
              "type": "object"
            },
            {
              "description": "Comportamento",
              "name": "Behavior",
